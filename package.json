{
    "name": "xtunes",
    "description": "A desktop music player built with Tauri, TypeScript and yt-dlp",
    "author": "Brad Moyetones",
    "type": "module",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.21.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/BradMoyetones/xtunes"
    },
    "scripts": {
        "typecheck": "turbo run typecheck",
        "typecheck-app": "cd apps/desktop && pnpm typecheck",
        "typecheck-ui": "cd packages/ui && pnpm typecheck",
        "typecheck-api": "cd packages/api && pnpm typecheck",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\"",
        "version-packages": "changeset version",
        "tree": "node scripts/tree.js"
    },
    "devDependencies": {
        "prettier": "^3.9.3",
        "turbo": "latest"
    }
}
