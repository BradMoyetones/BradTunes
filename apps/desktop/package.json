{
    "name": "xtunes",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tauri dev",
        "icon": "tauri icon app-icon.svg",
        "dev:vite": "vite",
        "build:vite": "tsc && vite build",
        "build": "tauri build",
        "build:splash": "pnpm dlx @tailwindcss/cli -i ./src/ui/styles/index.css -o ./public/splash.css",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "tauri": "tauri",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
        "changeset": "changeset",
        "version-packages": "changeset version && node scripts/sync-release.js"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@xtunes/api": "workspace:*",
        "@xtunes/ui": "workspace:*",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^8.3.0",
        "shadcn": "^4.18.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "@types/node": "^26.2.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "typescript": "~5.8.3",
        "vite": "^7.0.4"
    }
}
